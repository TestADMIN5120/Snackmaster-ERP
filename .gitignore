# 🚨 NEVER ignore *.json! We need package.json for deployment.

# 1. Ignore Secret Keys (CRITICAL)
credentials.json
serviceAccountKey.json
.serviceAccountKey.json
client_secret.json
key.json
snackmaster-refill-firebase-adminsdk-fbsvc-e01d5d273a.json
*firebase-adminsdk*.json

# 2. Ignore Environment Variables (CRITICAL)
.env
.env.local
frontend/.env
frontend/.env.local

# 3. Ignore Dependencies (The 10,000 files issue)
node_modules/
frontend/node_modules/
venv/
env/
__pycache__/
*.pyc
.csv

# 4. Ignore Production Build Folders (Vite creates these)
dist/
build/
frontend/dist/
frontend/build/

# 5. Ignore System & Error files
.DS_Store
npm-debug.log*
yarn-error.log*

# 6. Ignore Custom/Temp files
samples/
restoresalesdashbaord.jsx